# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA comite o .env — ele está no .gitignore por isso.
#
# Só é necessário se você for mexer em /login, /registro ou /dashboard.
# Todo o conteúdo público do site funciona sem banco nenhum.

# ===== Banco de dados =====
# Postgres local: postgres://postgres:SENHA@localhost:5432/cyberguard
DATABASE_URL="postgres://postgres:TROQUE_AQUI@localhost:5432/cyberguard"

# ===== Auth (JWT) =====
# Gere com: openssl rand -base64 48
JWT_SECRET=TROQUE_AQUI

# ===== App =====
NEXT_PUBLIC_APP_NAME="CyberGuard"
